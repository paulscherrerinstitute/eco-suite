# Networked (Ethernet/PoE) control box: the PSI "Motor Control Unit" box.
# Install to /etc/systemd/system/ (setup_box.sh does this for you), then:
#   sudo systemctl enable --now eco-control-box
#
# It connects OUT to the PC running the eco session, retrying forever, so
# power-up order does not matter and it reconnects by itself whenever the
# eco session is restarted. Edit PC_HOST/PC_PORT in /etc/eco-control-box.env.
[Unit]
Description=eco manual-control box (touchscreen + joystick + encoder)
After=graphical.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
# The box's local touchscreen X display:
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
EnvironmentFile=/etc/eco-control-box.env
WorkingDirectory=/opt/eco-control-box
ExecStart=/usr/bin/python3 -m manual_control.remote.pi_app \
    --tcp ${PC_HOST} ${PC_PORT} \
    --token-file /etc/eco-control-box.token \
    --preset psi-mcu-box --size 800x480 --font-scale 1.4 --fullscreen
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
