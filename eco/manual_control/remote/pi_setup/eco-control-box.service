# The control box app: it LISTENS for eco sessions and asks the operator
# whether to accept each one. Install to /etc/systemd/system/ (setup_box.sh
# does this), then: sudo systemctl enable --now eco-control-box
#
# Nothing here names a console: any machine holding the shared token may
# call this box, and whoever holds the box decides. Port in
# /etc/eco-control-box.env.
[Unit]
Description=eco manual-control box (touchscreen + joystick + encoder)
After=graphical.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
# The box's local touchscreen X display:
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
EnvironmentFile=/etc/eco-control-box.env
WorkingDirectory=/opt/eco-control-box
ExecStart=/usr/bin/python3 -m manual_control.remote.pi_app \
    --listen ${LISTEN_PORT} \
    --token-file /etc/eco-control-box.token \
    --preset psi-mcu-box --size 800x480 --font-scale 1.4 --fullscreen
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
