[Unit]
Description=eco manual-control pendant (touchscreen + joystick + encoder)
After=graphical.target

[Service]
Type=simple
User=pi
# The Pi's local touchscreen X display:
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
# Directory that CONTAINS the copied `manual_control/` package folder:
WorkingDirectory=/home/pi/manual_control_pi
# Bluetooth RFCOMM link (see SETUP.md) so the USB port stays free to charge.
# USB-gadget-serial alternative: --serial /dev/ttyGS0
ExecStart=/usr/bin/python3 -m manual_control.remote.pi_app --serial /dev/rfcomm0 --fullscreen --idle-blank 60
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
